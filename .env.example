# =====================================================
# CreativePulse AI — Environment Configuration Template
# =====================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env or frontend/.env.local to source control.

# =====================================================
# DATABASE
# =====================================================
# PostgreSQL is the intended production database.
# SQLite (sqlite:///./creativepulse_test.db) is accepted for local development
# only — it does not support all Alembic migration features.
DATABASE_URL=postgresql://user:password@localhost:5432/creativepulse

# =====================================================
# JWT AUTHENTICATION
# =====================================================
# Generate a secure secret:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-secret-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =====================================================
# CORS
# =====================================================
FRONTEND_URL=http://localhost:3000

# =====================================================
# CLOUDINARY (optional — enables asset upload and repurposing)
# =====================================================
# Get these from https://cloudinary.com/console
# Leave blank to disable Cloudinary features (the app runs without them).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================================================
# LLM PROVIDER (optional — enables conversational AI assistant)
# =====================================================
# Not yet wired up. Leave blank; the assistant uses grounded analytics instead.
# LLM_API_KEY=
# LLM_MODEL=

# =====================================================
# FRONTEND  (frontend/.env.local)
# =====================================================
# NEXT_PUBLIC_API_URL=http://localhost:8000
